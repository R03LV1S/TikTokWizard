# TikTokWizard .gitignore
# ------------------------------------------------------------------------------
# Virtual environments (created automatically by run.bat / run.sh per user machine)
# ------------------------------------------------------------------------------
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/

# ------------------------------------------------------------------------------
# Python bytecode & runtime cache
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# ------------------------------------------------------------------------------
# Intermediate alignment cache & user project output renders
# ------------------------------------------------------------------------------
**/.data/
DO NOT TOUCH/data/
DO NOT TOUCH/models/
DO NOT TOUCH/envs/
DO NOT TOUCH/compute_profile.json
build/
output/
.whisper_cache.json
**/.whisper_cache.json
render-history.json
.render-history.json.tmp
*.tmp

# Ignore personal user song projects & heavy downloaded assets, keeping PaoPao sample & starter assets
START HERE/_Projects/*/
!START HERE/_Projects/PaoPao - Grax/
!START HERE/_Projects/Artist_-_Song-EXAMPLE ONLY/
!START HERE/_Projects/_Assets/
START HERE/_Projects/_Assets/4D Effect/
START HERE/_Projects/*/*.mp4
START HERE/_Projects/*/*.mkv
START HERE/_Projects/*/*.mov
START HERE/_Projects/*/*.avi
START HERE/_Projects/*/Vocal Stem/
START HERE/_Projects/_Assets/Backgrounds/Videos/*.mp4
!START HERE/_Projects/_Assets/Backgrounds/Videos/default.mp4
START HERE/_Projects/_Assets/Overlays/*.mov

# ------------------------------------------------------------------------------
# Release archives, distribution zips & local GitHub staging folders
# ------------------------------------------------------------------------------
.Github__/
**/.Github__/
.Github*
**/__*
!**/__init__.py
!**/__main__.py
*.zip
*.tar.gz
*.7z

# ------------------------------------------------------------------------------
# OS-generated files & developer scratch
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
