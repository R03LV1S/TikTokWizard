# ============================================================
# TikTok Wizard - repository ignore rules
#
# Publishing rule: NO VIDEO FILES ARE PUBLISHED. Background clips,
# ambient overlays and every rendered output are excluded here and
# stripped from the working copy by hand before a release.
# Project folders keep their audio (mp3) and lyrics (txt).
# ============================================================

# ---- build output / caches ----
build/
output/
**/__pycache__/
*.pyc
*.pyo
*.tmp
.DS_Store
Thumbs.db

# ---- local runtime state ----
DO NOT TOUCH/logs/
DO NOT TOUCH/scratch/
DO NOT TOUCH/data/
DO NOT TOUCH/build/
DO NOT TOUCH/output/
DO NOT TOUCH/render-history.json
DO NOT TOUCH/venv/
DO NOT TOUCH/venv/**
DO NOT TOUCH/src/**/__pycache__/

# ---- developer-only helpers (not published) ----
tools/

# ---- developer scratch ----
_dev/
implementation_summary.txt

# ---- NO VIDEOS ARE PUBLISHED ----
*.mp4
*.webm
*.mov
*.mkv
*.avi
*.m4v
*.flv

# ---- other large / generated binaries ----
*.wav
*.zip
*.7z
*.exe
*.onnx
*.bin
*.safetensors

# ---- local secrets ----
.env
*.key
